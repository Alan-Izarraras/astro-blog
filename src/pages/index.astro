---
const pageTitle = "Alan R. Izarraras Gómez";
const tagline = "Scientist • Writer • Creative";

import { getCollection } from 'astro:content';
const allPosts = await getCollection('blog');

// Sort by date (newest first)
const sortedPosts = allPosts.sort((a, b) => 
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  
  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  <style>
    .blog-list {
      max-width: 800px;
      margin: 2rem auto;
    }

    .post-item {
      margin-bottom: 0.8rem;
      border-bottom: 1px solid #dddddd;
      padding-bottom: 0.8rem;
    }

    .post-item summary {
      font-size: 1.25rem;
      font-weight: 600;
      cursor: pointer;
      padding: 0.5rem 0;
      list-style: none;
      display: flex;
      justify-content: space-between;
      align-items: center;
      user-select: none;
    }

    .post-item summary:hover {
      color: #ccad00;
    }

    .post-item .arrow {
      font-size: 1.8rem;
      transition: transform 0.4s ease;
      transform-origin: center;
    }

    .post-item[open] .arrow {
      transform: rotate(90deg);
    }

    .description-link {
      display: block;
      color: #ccad00;
      text-decoration: none;
      line-height: 1.6;
      font-size: 1.05rem;
    }

    .description-link:hover {
      text-decoration: underline;
      color: #0055aa;
    }

    .post-item .post-content {
      padding: 0 0 1.5rem 0;
    }
    
    .post-image {
      width: 100%;
      max-height: 320px;
      object-fit: cover;
      border-radius: 12px;
      margin-bottom: 0.5rem;
    }

    .read-more {
      display: inline-block;
      margin-top: 0.5rem;
      color: #0066cc;
      font-weight: 500;
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
  </style>

</head>
<body>
  <header>
    <div class="title-group">
      <h1>{pageTitle}</h1>
      <p class="tagline">{tagline}</p>
    </div>
    <img src="/images/logo_colorful.png" alt="A. Izarraras" class="logo" />
  </header>

  <main>
    <h2>Blog Posts</h2>

    <div class="blog-list">
      {sortedPosts.map(post => (
        <details class="post-item">
          <summary>
            <span class="title">{post.data.title}</span>
            <span class="arrow">›</span>
          </summary
        
          <div class="post-content">
            {post.data.image && (
              <img src={post.data.image} alt={post.data.title} class="post-image" />
            )}
            <a href={`/blog/${post.id}`} class="description-link">
              {post.data.description}
            </a>
          </div>
        </details>
      ))}
    </div>
  </main>
</body>
</html>