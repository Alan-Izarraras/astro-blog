---
const pageTitle = "Alan R. Izarraras Gómez";
const tagline = "Scientist • Writer • Creative";

import { getCollection } from 'astro:content';
const allPosts = await getCollection('blog');

const sortedPosts = allPosts.sort((a, b) => 
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  <style>
    :root {
      --bg: #F5EFE6;
      --card: #E8DFCA;
      --accent: #6D94C5;
      --text: #2c2c2c;
      --light: #CBDCEB;
    }

    /* DARK MODE */
    html[data-theme="dark"] {
      --bg: #1f1c18;
      --card: #2c2822;
      --accent: #8eb8e0;
      --text: #f0e8d8;
      --light: #3a3530;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: system-ui, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.7;
      transition: background 0.4s ease, color 0.4s ease;
    }

    /* ==================== NAVIGATION ==================== */
    nav {
      padding: 1.2rem 0 1.8rem 0;
      text-align: center;
    }

    .nav-container {
      max-width: 1000px;
      margin: 0 auto;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 2rem;
    }

    .nav-menu {
      display: inline-flex;
      align-items: center;
      gap: 1.4rem;
      font-size: 1.05rem;
    }

    .nav-link {
      color: var(--text);
      text-decoration: none;
      font-weight: 500;
      transition: color 0.3s ease;
    }

    .nav-link:hover {
      color: var(--accent);
    }

    .separator {
      color: #bbb;
      font-size: 1.1rem;
    }

    /* Theme Toggle */
    .theme-toggle {
      background: none;
      border: none;
      font-size: 1.6rem;
      cursor: pointer;
      padding: 8px;
      border-radius: 50%;
      transition: transform 0.3s ease;
    }

    .theme-toggle:hover {
      transform: scale(1.15);
    }

    /* ==================== HEADER ==================== */
    header {
      background: white;
      padding: 5rem 1rem 4rem;
      text-align: center;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
    }

    .header-content {
      max-width: 1000px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 3rem;
      flex-wrap: wrap;
    }

    .title-group h1 {
      font-size: 3.6rem;
      color: var(--text);
    }

    .tagline {
      font-size: 1.6rem;
      color: #555;
      margin-top: 0.5rem;
    }

    .logo {
      width: 180px;
      opacity: 0.75;
      transition: opacity 0.3s;
    }

    .logo:hover { opacity: 1; }

    /* ==================== MAIN ==================== */
    main {
      max-width: 1000px;
      margin: 0 auto;
      padding: 0 2rem 5rem;
    }

    h2 {
      font-size: 2.4rem;
      color: var(--accent);
      text-align: center;
      margin: 3.5rem 0 2rem 0;
    }

    .section {
      background: var(--card);
      padding: 4rem 2rem;
      border-radius: 20px;
      margin-bottom: 3rem;
      text-align: center;
      box-shadow: 0 6px 25px rgba(0, 0, 0, 0.08);
      min-height: 220px;
    }

    /* Blog Accordion */
    .blog-list {
      max-width: 800px;
      margin: 0 auto;
    }

    .post-item {
      margin-bottom: 1.2rem;
      background: var(--card);
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.07);
    }

    .post-item summary {
      font-size: 1.3rem;
      font-weight: 600;
      padding: 1.4rem 1.8rem;
      cursor: pointer;
      list-style: none;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .post-item .arrow {
      font-size: 1.9rem;
      transition: transform 0.4s ease;
    }

    .post-item[open] .arrow {
      transform: rotate(90deg);
    }

    .post-content {
      padding: 0 1.8rem 2rem 1.8rem;
    }

    .post-image {
      width: 100%;
      height: 240px;
      object-fit: cover;
      border-radius: 12px;
      margin-bottom: 1.2rem;
    }

    .description-link {
      color: var(--accent);
      text-decoration: none;
      font-size: 1.08rem;
    }

    .description-link:hover {
      text-decoration: underline;
    }

    @media (max-width: 768px) {
      .header-content { gap: 2rem; }
      .logo { width: 150px; }
      h1 { font-size: 3rem; }
      .nav-menu { gap: 1rem; font-size: 1rem; }
    }
  </style>
</head>
<body>
  <!-- Header -->
  <header>
    <div class="header-content">
      <div class="title-group">
        <h1>{pageTitle}</h1>
        <p class="tagline">{tagline}</p>
      </div>
      <img src="/images/logo_colorful.png" alt="A. Izarraras" class="logo" />
    </div>
  </header>

  <!-- Compact Navigation -->
  <nav>
    <div class="nav-container">
      <div class="nav-menu">
        <a href="#about" class="nav-link">About Me</a>
        <span class="separator">|</span>
        <a href="#blog" class="nav-link">Blog</a>
        <span class="separator">|</span>
        <a href="#art" class="nav-link">Art</a>
        <span class="separator">|</span>
        <a href="#academic" class="nav-link">Academic</a>
      </div>

      <!-- Dark / Light Toggle -->
      <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme">
        🌞
      </button>
    </div>
  </nav>

  <main>
    <!-- About Me -->
    <h2 id="about">About Me</h2>
    <div class="section">
      <p>Content coming soon...</p>
    </div>

    <!-- Blog Posts -->
    <h2 id="blog">Blog Posts</h2>
    <div class="blog-list">
      {sortedPosts.map(post => (
        <details class="post-item">
          <summary>
            <span>{post.data.title}</span>
            <span class="arrow">›</span>
          </summary>
          <div class="post-content">
            {post.data.image && <img src={post.data.image} alt={post.data.title} class="post-image" />}
            <a href={`/blog/${post.id}`} class="description-link">
              {post.data.description}
            </a>
          </div>
        </details>
      ))}
    </div>

    <!-- Art -->
    <h2 id="art">Art</h2>
    <div class="section">
      <p>Content coming soon...</p>
    </div>

    <!-- Academic -->
    <h2 id="academic">Academic</h2>
    <div class="section">
      <p>Content coming soon...</p>
    </div>
  </main>

  <script>
    const toggle = document.getElementById('theme-toggle');
    const html = document.documentElement;

    // Check for saved theme
    if (localStorage.getItem('theme') === 'dark' || 
        (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      html.setAttribute('data-theme', 'dark');
      toggle.textContent = '🌙';
    }

    toggle.addEventListener('click', () => {
      if (html.getAttribute('data-theme') === 'dark') {
        html.removeAttribute('data-theme');
        toggle.textContent = '🌞';
        localStorage.setItem('theme', 'light');
      } else {
        html.setAttribute('data-theme', 'dark');
        toggle.textContent = '🌙';
        localStorage.setItem('theme', 'dark');
      }
    });
  </script>
</body>
</html>